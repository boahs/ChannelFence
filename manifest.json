{
  "manifest_version": 3,
  "name": "ChannelFence – Creator Blocker",
  "short_name": "ChannelFence",
  "version": "0.1.3",
  "description": "Block YouTube channels and creators across Home, search, recommendations, Shorts, comments, and direct visits.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "action": {
    "default_title": "ChannelFence",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "assets/icons/channelfence-16.png",
      "32": "assets/icons/channelfence-32.png",
      "48": "assets/icons/channelfence-48.png",
      "128": "assets/icons/channelfence-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/channelfence-16.png",
    "32": "assets/icons/channelfence-32.png",
    "48": "assets/icons/channelfence-48.png",
    "128": "assets/icons/channelfence-128.png"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "css": [
        "src/content.css"
      ],
      "js": [
        "src/shared.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
