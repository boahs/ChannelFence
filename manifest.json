{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "ChannelFence",
  "version": "0.2.6",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "homepage_url": "https://channelfence.app/",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "action": {
    "default_title": "ChannelFence",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "assets/icons/channelfence-16.png",
      "32": "assets/icons/channelfence-32.png",
      "48": "assets/icons/channelfence-48.png",
      "128": "assets/icons/channelfence-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/channelfence-16.png",
    "32": "assets/icons/channelfence-32.png",
    "48": "assets/icons/channelfence-48.png",
    "128": "assets/icons/channelfence-128.png"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "css": [
        "src/content.css"
      ],
      "js": [
        "src/shared.js",
        "src/i18n.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/channelfence-48.png"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ]
    }
  ]
}
