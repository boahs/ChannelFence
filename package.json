{
  "name": "channelfence",
  "version": "0.2.10",
  "private": true,
  "description": "Automated tests and developer tooling for the ChannelFence browser extension.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "analytics:store": "node --env-file=.env scripts/fetch-store-analytics.mjs",
    "build:firefox": "node scripts/build-firefox.mjs",
    "test:firefox": "playwright test --config=playwright.firefox.config.ts --project=firefox",
    "test:firefox:live": "playwright test --config=playwright.firefox.config.ts --project=firefox-live --workers=1",
    "test": "npm run test:unit && npm run typecheck && npm run test:e2e",
    "test:unit": "node --experimental-strip-types --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --project=extension",
    "test:e2e:headed": "playwright test --project=extension --headed",
    "test:e2e:ui": "playwright test --project=extension --ui",
    "test:e2e:live": "playwright test --project=live-youtube --workers=1",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@google-analytics/data": "6.1.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "puppeteer-core": "25.16.0",
    "typescript": "7.0.2",
    "web-ext": "10.8.0"
  }
}
