{
  "name": "channelfence",
  "version": "0.2.2",
  "private": true,
  "description": "Automated tests and developer tooling for the ChannelFence Chrome extension.",
  "license": "MIT",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "analytics:store": "node --env-file=.env scripts/fetch-store-analytics.mjs",
    "test": "npm run test:unit && npm run typecheck && npm run test:e2e",
    "test:unit": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --project=extension",
    "test:e2e:headed": "playwright test --project=extension --headed",
    "test:e2e:ui": "playwright test --project=extension --ui",
    "test:e2e:live": "playwright test --project=live-youtube",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@google-analytics/data": "6.1.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}
